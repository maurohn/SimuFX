<Application x:Class="SimuConfig.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ===== COLOR PALETTE ===== -->
        <Color x:Key="BgDeep">#0D0D10</Color>
        <Color x:Key="BgBase">#12121A</Color>
        <Color x:Key="BgPanel">#1A1A24</Color>
        <Color x:Key="BgCard">#22222E</Color>
        <Color x:Key="Accent">#E8661A</Color>
        <Color x:Key="AccentLight">#FF8C40</Color>
        <Color x:Key="TextPrimary">#F0F0F4</Color>
        <Color x:Key="TextSecondary">#9090A0</Color>
        <Color x:Key="Border">#2E2E40</Color>

        <SolidColorBrush x:Key="BrBgDeep"   Color="{StaticResource BgDeep}"/>
        <SolidColorBrush x:Key="BrBgBase"   Color="{StaticResource BgBase}"/>
        <SolidColorBrush x:Key="BrBgPanel"  Color="{StaticResource BgPanel}"/>
        <SolidColorBrush x:Key="BrBgCard"   Color="{StaticResource BgCard}"/>
        <SolidColorBrush x:Key="BrAccent"   Color="{StaticResource Accent}"/>
        <SolidColorBrush x:Key="BrAccentL"  Color="{StaticResource AccentLight}"/>
        <SolidColorBrush x:Key="BrText"     Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="BrTextSec"  Color="{StaticResource TextSecondary}"/>
        <SolidColorBrush x:Key="BrBorder"   Color="{StaticResource Border}"/>
        <SolidColorBrush x:Key="BrTrans"    Color="Transparent"/>

        <!-- ===== FONT ===== -->
        <FontFamily x:Key="FontMain">Segoe UI</FontFamily>

        <!-- ===== COMBOBOX STYLE ===== -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BrBgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource BrText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMain}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ===== CHECKBOX STYLE ===== -->
        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrText}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ===== SLIDER STYLE ===== -->
        <Style x:Key="AccentSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource BrAccent}"/>
            <Setter Property="Height" Value="20"/>
        </Style>

        <!-- ===== LABEL STYLE ===== -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrTextSec}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMain}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>

        <!-- ===== SECTION HEADER ===== -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrAccent}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMain}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <!-- ===== BUTTON ===== -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E8661A" Offset="0"/>
                        <GradientStop Color="#C04010" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource BrBgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource BrTextSec}"/>
        </Style>

        <!-- ===== TAB CONTROL ===== -->
        <Style x:Key="DarkTab" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrTextSec}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}"
                                Cursor="Hand">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
