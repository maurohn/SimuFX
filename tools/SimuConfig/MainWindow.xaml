<Window x:Class="SimuConfig.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimuConfig — SimuV3 Configuration" 
        Height="900" Width="1200"
        MinHeight="700" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrBgDeep}"
        Foreground="{StaticResource BrText}"
        FontFamily="{StaticResource FontMain}"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>   <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="52"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER                                                     -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="{StaticResource BrBgPanel}"
                BorderBrush="{StaticResource BrBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrAccent}" Width="4" 
                            CornerRadius="2" Margin="0,8,14,8"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SimuConfig" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource BrText}"/>
                        <TextBlock x:Name="SubtitleText" Text="SimuV3 — rFactor 1 Configuration"
                                   FontSize="11" Foreground="{StaticResource BrTextSec}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" 
                            VerticalAlignment="Center">
                    <TextBlock x:Name="GamePathLabel" Text="Ruta del juego: buscando..."
                               Foreground="{StaticResource BrTextSec}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="📁  Cambiar ruta" Style="{StaticResource SecondaryBtn}"
                            Click="BrowseGamePath_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- MAIN CONTENT                                               -->
        <!-- ========================================================= -->
        <Grid Grid.Row="1" Margin="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520"/>    <!-- Left: Config panels -->
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>      <!-- Right: Preview -->
            </Grid.ColumnDefinitions>

            <!-- =================== LEFT PANEL =================== -->
            <Border Grid.Column="0" Background="{StaticResource BrBgPanel}"
                    CornerRadius="10" Padding="0">
                <TabControl Style="{StaticResource DarkTab}">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource DarkTabItem}"/>
                    </TabControl.Resources>

                    <!-- ─────── TAB: JUEGO ─────── -->
                    <TabItem Header="🎮  Juego">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel>

                                <!-- GPU -->
                                <TextBlock Text="VIDEO ADAPTER" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Placa de video" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CbAdapter" Style="{StaticResource DarkCombo}"
                                          SelectionChanged="OnGameSettingChanged"/>

                                <!-- Resolution -->
                                <TextBlock Text="PANTALLA" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Resolución" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CbResolution" Style="{StaticResource DarkCombo}"
                                          SelectionChanged="OnGameSettingChanged"/>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Bits de color" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CbColorBits" Style="{StaticResource DarkCombo}"
                                                  SelectionChanged="OnGameSettingChanged">
                                            <ComboBoxItem Content="16 bit"/>
                                            <ComboBoxItem Content="32 bit" IsSelected="True"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Tasa de refresco" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CbRefresh" Style="{StaticResource DarkCombo}"
                                                  SelectionChanged="OnGameSettingChanged"/>
                                        <!-- Items populated dynamically from supported display modes -->
                                    </StackPanel>
                                </Grid>

                                <!-- Quality -->
                                <TextBlock Text="CALIDAD GRÁFICA" Style="{StaticResource SectionHeader}"/>

                                <TextBlock Text="Nivel de sombreado" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CbShaderLevel" Style="{StaticResource DarkCombo}"
                                          SelectionChanged="OnGameSettingChanged">
                                    <ComboBoxItem Content="Básico (DX7)" Tag="0"/>
                                    <ComboBoxItem Content="Media (DX8)" Tag="1"/>
                                    <ComboBoxItem Content="Alta (DX8.1)" Tag="2"/>
                                    <ComboBoxItem Content="Calidad (DX9)" Tag="3"/>
                                </ComboBox>

                                <TextBlock Text="Anti-Aliasing" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CbFSAA" Style="{StaticResource DarkCombo}"
                                          SelectionChanged="OnGameSettingChanged">
                                    <ComboBoxItem Content="Off" Tag="0"/>
                                    <ComboBoxItem Content="2x" Tag="1"/>
                                    <ComboBoxItem Content="4x" Tag="3"/>
                                    <ComboBoxItem Content="8x" Tag="7"/>
                                    <ComboBoxItem Content="Level 5" Tag="15"/>
                                    <ComboBoxItem Content="Level 6" Tag="23"/>
                                    <ComboBoxItem Content="Level 7" Tag="31"/>
                                    <ComboBoxItem Content="Level 8" Tag="39"/>
                                </ComboBox>

                                <!-- Opciones -->
                                <TextBlock Text="OPCIONES" Style="{StaticResource SectionHeader}"/>
                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ChkVSync" Content="VSync On" 
                                              Style="{StaticResource DarkCheck}"
                                              Margin="0,4,20,4"
                                              Checked="OnGameSettingChanged" Unchecked="OnGameSettingChanged"/>
                                    <CheckBox x:Name="ChkWidescreen" Content="Widescreen UI"
                                              Style="{StaticResource DarkCheck}"
                                              Margin="0,4,20,4"
                                              Checked="OnGameSettingChanged" Unchecked="OnGameSettingChanged"/>
                                    <CheckBox x:Name="ChkWindowed" Content="Modo Ventana"
                                              Style="{StaticResource DarkCheck}"
                                              Margin="0,4,20,4"
                                              Checked="OnGameSettingChanged" Unchecked="OnGameSettingChanged"/>
                                    <CheckBox x:Name="ChkMultiView" Content="MultiView"
                                              Style="{StaticResource DarkCheck}"
                                              Margin="0,4,20,4"
                                              Checked="OnGameSettingChanged" Unchecked="OnGameSettingChanged"/>
                                </WrapPanel>

                                <!-- Language -->
                                <TextBlock Text="IDIOMA" Style="{StaticResource SectionHeader}"/>
                                <ComboBox x:Name="CbLanguage" Style="{StaticResource DarkCombo}"
                                          SelectionChanged="OnGameSettingChanged">
                                    <ComboBoxItem Content="Español"       Tag="SPANISH.DIC"/>
                                    <ComboBoxItem Content="English"       Tag="ENGLISH-USA.DIC"/>
                                    <ComboBoxItem Content="Deutsch"       Tag="DEUTSCH.DIC"/>
                                    <ComboBoxItem Content="Français"      Tag="FRENCH.DIC"/>
                                    <ComboBoxItem Content="Italiano"      Tag="ITALIAN.DIC"/>
                                    <ComboBoxItem Content="Português (BR)" Tag="PORTUGUESE-BR.DIC"/>
                                </ComboBox>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ─────── TAB: SIMUFX ─────── -->
                    <TabItem Header="✨  SimuFX">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel>

                                <!-- Preset -->
                                <TextBlock Text="PRESET" Style="{StaticResource SectionHeader}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CbPreset" Style="{StaticResource DarkCombo}"
                                              SelectionChanged="CbPreset_SelectionChanged"/>
                                    <Button Grid.Column="2" Content="Cargar" 
                                            Style="{StaticResource SecondaryBtn}"
                                            Click="LoadPreset_Click" Width="70"/>
                                </Grid>

                                 <!-- Save new preset -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox x:Name="TxtNewPreset" 
                                                 Background="{StaticResource BrBgCard}"
                                                 Foreground="{StaticResource BrText}"
                                                 BorderBrush="{StaticResource BrBorder}"
                                                 BorderThickness="1"
                                                 Padding="8,6"
                                                 FontSize="13"
                                                 VerticalContentAlignment="Center"
                                                 Height="32"/>
                                        <TextBlock IsHitTestVisible="False" Text="Nombre del nuevo preset..."
                                                   Foreground="{StaticResource BrTextSec}" FontSize="13"
                                                   Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtNewPreset}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Column="2" Content="Guardar" 
                                            Style="{StaticResource PrimaryBtn}"
                                            Click="SavePreset_Click" Width="80"/>
                                </Grid>

                                <!-- Filtrado anisotropico -->
                                <TextBlock Text="TEXTURAS" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Filtrado Anisotrópico" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CbAnisotropic" Style="{StaticResource DarkCombo}"
                                          SelectionChanged="OnFXSettingChanged">
                                    <ComboBoxItem Content="Desactivado (1x)"/>
                                    <ComboBoxItem Content="2x"/>
                                    <ComboBoxItem Content="4x"/>
                                    <ComboBoxItem Content="8x"/>
                                    <ComboBoxItem Content="16x  (Máxima calidad)" IsSelected="True"/>
                                </ComboBox>

                                <!-- Tonemap -->
                                <TextBlock Text="TONEMAP" Style="{StaticResource SectionHeader}"/>
                                <CheckBox x:Name="ChkTonemap" Content="Activar Tonemap"
                                          Style="{StaticResource DarkCheck}"
                                          Checked="OnFXSettingChanged" Unchecked="OnFXSettingChanged"/>

                                <TextBlock Text="Exposición" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="SldExposure" Style="{StaticResource AccentSlider}"
                                            Minimum="-1" Maximum="1" ValueChanged="OnFXSettingChanged"/>
                                    <TextBlock x:Name="LblExposure" Grid.Column="1" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrTextSec}" FontSize="11" TextAlignment="Right"/>
                                </Grid>

                                <TextBlock Text="Contraste" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="SldContrast" Style="{StaticResource AccentSlider}"
                                            Minimum="0.5" Maximum="2" ValueChanged="OnFXSettingChanged"/>
                                    <TextBlock x:Name="LblContrast" Grid.Column="1" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrTextSec}" FontSize="11" TextAlignment="Right"/>
                                </Grid>

                                <TextBlock Text="Sombras (lift)" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="SldShadows" Style="{StaticResource AccentSlider}"
                                            Minimum="0" Maximum="2" ValueChanged="OnFXSettingChanged"/>
                                    <TextBlock x:Name="LblShadows" Grid.Column="1" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrTextSec}" FontSize="11" TextAlignment="Right"/>
                                </Grid>

                                <TextBlock Text="Highlights" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="SldHighlights" Style="{StaticResource AccentSlider}"
                                            Minimum="0" Maximum="2" ValueChanged="OnFXSettingChanged"/>
                                    <TextBlock x:Name="LblHighlights" Grid.Column="1" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrTextSec}" FontSize="11" TextAlignment="Right"/>
                                </Grid>

                                <!-- Color -->
                                <TextBlock Text="COLOR" Style="{StaticResource SectionHeader}"/>
                                <CheckBox x:Name="ChkColor" Content="Activar Color Boost"
                                          Style="{StaticResource DarkCheck}"
                                          Checked="OnFXSettingChanged" Unchecked="OnFXSettingChanged"/>

                                <TextBlock Text="Saturación" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="SldSaturation" Style="{StaticResource AccentSlider}"
                                            Minimum="0.5" Maximum="2" ValueChanged="OnFXSettingChanged"/>
                                    <TextBlock x:Name="LblSaturation" Grid.Column="1" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrTextSec}" FontSize="11" TextAlignment="Right"/>
                                </Grid>

                                <TextBlock Text="Vibrance" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="SldVibrance" Style="{StaticResource AccentSlider}"
                                            Minimum="0" Maximum="1" ValueChanged="OnFXSettingChanged"/>
                                    <TextBlock x:Name="LblVibrance" Grid.Column="1" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrTextSec}" FontSize="11" TextAlignment="Right"/>
                                </Grid>

                                <!-- AA -->
                                <TextBlock Text="ANTI-ALIASING (FXAA POST-PROCESS)" Style="{StaticResource SectionHeader}"/>
                                <CheckBox x:Name="ChkFXAA" Content="Activar FXAA"
                                          Style="{StaticResource DarkCheck}"
                                          Checked="OnFXSettingChanged" Unchecked="OnFXSettingChanged"/>
                                <TextBlock Text="Intensidad FXAA" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="SldFXAA" Style="{StaticResource AccentSlider}"
                                            Minimum="0" Maximum="1" ValueChanged="OnFXSettingChanged"/>
                                    <TextBlock x:Name="LblFXAA" Grid.Column="1" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrTextSec}" FontSize="11" TextAlignment="Right"/>
                                </Grid>

                                <!-- Sharpen -->
                                <TextBlock Text="NITIDEZ (CAS SHARPEN)" Style="{StaticResource SectionHeader}"/>
                                <CheckBox x:Name="ChkSharpen" Content="Activar Sharpen"
                                          Style="{StaticResource DarkCheck}"
                                          Checked="OnFXSettingChanged" Unchecked="OnFXSettingChanged"/>
                                <TextBlock Text="Intensidad" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="SldSharpen" Style="{StaticResource AccentSlider}"
                                            Minimum="0" Maximum="1.5" ValueChanged="OnFXSettingChanged"/>
                                    <TextBlock x:Name="LblSharpen" Grid.Column="1" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrTextSec}" FontSize="11" TextAlignment="Right"/>
                                </Grid>

                                <!-- AO -->
                                <TextBlock Text="AMBIENT OCCLUSION" Style="{StaticResource SectionHeader}"/>
                                <CheckBox x:Name="ChkAO" Content="Activar AO (sombras de contacto)"
                                          Style="{StaticResource DarkCheck}"
                                          Checked="OnFXSettingChanged" Unchecked="OnFXSettingChanged"/>
                                <TextBlock Text="Intensidad AO" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="SldAO" Style="{StaticResource AccentSlider}"
                                            Minimum="0" Maximum="1.5" ValueChanged="OnFXSettingChanged"/>
                                    <TextBlock x:Name="LblAO" Grid.Column="1" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrTextSec}" FontSize="11" TextAlignment="Right"/>
                                </Grid>

                                <!-- Shadow Depth -->
                                <TextBlock Text="PROFUNDIDAD DE SOMBRAS" Style="{StaticResource SectionHeader}"/>
                                <CheckBox x:Name="ChkShadowDepth" Content="Activar Shadow Depth"
                                          Style="{StaticResource DarkCheck}"
                                          Checked="OnFXSettingChanged" Unchecked="OnFXSettingChanged"/>
                                <TextBlock Text="Profundidad" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="SldShadowDepth" Style="{StaticResource AccentSlider}"
                                            Minimum="0" Maximum="1" ValueChanged="OnFXSettingChanged"/>
                                    <TextBlock x:Name="LblShadowDepth" Grid.Column="1" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrTextSec}" FontSize="11" TextAlignment="Right"/>
                                </Grid>

                                <!-- Vignette -->
                                <TextBlock Text="VIÑETA" Style="{StaticResource SectionHeader}"/>
                                <CheckBox x:Name="ChkVignette" Content="Activar Vignette"
                                          Style="{StaticResource DarkCheck}"
                                          Checked="OnFXSettingChanged" Unchecked="OnFXSettingChanged"/>
                                <TextBlock Text="Intensidad" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="SldVignette" Style="{StaticResource AccentSlider}"
                                            Minimum="0" Maximum="1" ValueChanged="OnFXSettingChanged"/>
                                    <TextBlock x:Name="LblVignette" Grid.Column="1" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrTextSec}" FontSize="11" TextAlignment="Right"/>
                                </Grid>

                                <Border Height="16"/>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Border>

            <!-- =================== RIGHT PANEL: PREVIEW =================== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Preview image card -->
                <Border Grid.Row="0" Background="{StaticResource BrBgPanel}"
                        CornerRadius="10" ClipToBounds="True">
                    <Grid>
                        <!-- Image -->
                        <Image x:Name="PreviewImage" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Overlay label -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                Background="#99000000" CornerRadius="0,0,6,0"
                                Padding="10,6">
                            <TextBlock Text="PREVIEW EN VIVO" FontSize="10" 
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrAccent}"/>
                        </Border>

                        <!-- Processing indicator -->
                        <Border x:Name="ProcessingBadge" VerticalAlignment="Bottom" 
                                HorizontalAlignment="Right"
                                Background="{StaticResource BrAccent}" CornerRadius="6,0,0,0"
                                Padding="10,4" Visibility="Collapsed">
                            <TextBlock Text="Procesando..." FontSize="10" 
                                       Foreground="White" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- System Info card -->
                <Border Grid.Row="1" Background="{StaticResource BrBgPanel}"
                        CornerRadius="10" Margin="0,10,0,0" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="LblGPU" Text="GPU: Detectando..."
                                       Foreground="{StaticResource BrTextSec}" FontSize="11"/>
                            <TextBlock x:Name="LblVRAM" Text="VRAM: —"
                                       Foreground="{StaticResource BrTextSec}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="LblDirectX"  Text="DirectX: 9.0c"
                                       Foreground="{StaticResource BrTextSec}" FontSize="11"/>
                            <TextBlock x:Name="LblDriver" Text="Driver: —"
                                       Foreground="{StaticResource BrTextSec}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================================= -->
        <!-- FOOTER                                                     -->
        <!-- ========================================================= -->
        <Border Grid.Row="2" Background="{StaticResource BrBgPanel}"
                BorderBrush="{StaticResource BrBorder}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Listo."
                           Foreground="{StaticResource BrTextSec}"
                           FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" 
                            VerticalAlignment="Center">
                    <Button Content="Cancelar" Style="{StaticResource SecondaryBtn}"
                            Click="Cancel_Click" Width="100" Margin="0,0,10,0"/>
                    <Button Content="✓  Guardar y Salir" Style="{StaticResource PrimaryBtn}"
                            Click="SaveAll_Click" Width="160"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
